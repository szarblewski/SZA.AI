<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>sza</AssemblyName>
    <Version>1.0.7</Version>
    <RootNamespace>SZA.AI.CLI</RootNamespace>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>sza</ToolCommandName>
    <PackageId>SZA.AI.CLI</PackageId>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
    <PackageProjectUrl>https://github.com/szarblewski/SZA.AI</PackageProjectUrl>
    <RepositoryUrl>https://github.com/szarblewski/SZA.AI</RepositoryUrl>
    <Description>CLI para ativação e gerenciamento do SZA.AI Proxy.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Spectre.Console" Version="0.54.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" Link="README.md" />
    <None Include="..\LICENSE.txt" Pack="true" PackagePath="\" />
    <None Remove="proxy-bundle\**" />
    <Content Include="proxy-bundle\**" Pack="true" PackagePath="tools/net10.0/any/proxy" CopyToOutputDirectory="Never" />
  </ItemGroup>

</Project>
